# Используем официальный образ Alpine
FROM alpine:latest

# Устанавливаем nginx
RUN apk add --no-cache nginx

# Создаем директорию для веб-файлов
RUN mkdir -p /opt/www

# Создаем простой index.html
RUN echo "<h1>Hello from Alpine Nginx</h1>" > /opt/www/index.html

# Создаем минимальный конфиг nginx
RUN echo 'server { \
    listen 80; \
    root /opt/www; \
    index index.html; \
}' > /etc/nginx/http.d/default.conf

# Открываем порт 80
EXPOSE 80

# Запускаем nginx на переднем плане
CMD ["nginx", "-g", "daemon off;"]
