# Используем Debian 11 (bullseye)
FROM debian:11

# Обновляем пакеты и устанавливаем nginx
RUN apt-get update && apt-get install -y nginx && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Создаем директорию для веб-файлов
RUN mkdir -p /opt/www

# Создаем index.html
RUN echo "<h1>Hello from Debian Nginx</h1>" > /opt/www/index.html

# Создаем конфигурационный файл для нашего сайта
RUN echo 'server { \
    listen 80; \
    root /opt/www; \
    index index.html; \
}' > /etc/nginx/sites-available/default

# Открываем порт
EXPOSE 80

# Используем ENTRYPOINT для запуска (вместо CMD)
ENTRYPOINT ["nginx", "-g", "daemon off;"]
